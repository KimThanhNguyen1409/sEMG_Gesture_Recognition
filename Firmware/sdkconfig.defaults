# Target ESP32 Classic (ESP32-S AI-Thinker / ESP32-D0WD)
CONFIG_IDF_TARGET="esp32"

# CPU Frequency set to 240MHz for optimal DSP & FreeRTOS performance
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# FreeRTOS 1000 Hz tick rate
CONFIG_FREERTOS_HZ=1000

# Static Allocation support enabled for zero-malloc architecture
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y

# Console Output Configuration
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ADC Calibration support
CONFIG_ADC_CALI_EFUSE_TP_ENABLE=y
CONFIG_ADC_CALI_EFUSE_VREF_ENABLE=y
CONFIG_ADC_CALI_LUT_ENABLE=y
